{
  "name": "@dooziesoft/doozctl-standards",
  "version": "0.1.0",
  "description": "Sample standards package for DoozCTL. A starting point to copy and adapt, not policy.",
  "license": "MIT",
  "keywords": [
    "doozctl",
    "standards",
    "template",
    "ai",
    "agents"
  ],
  "files": [
    "agent-instructions.md",
    "developers.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "format": 2,
  "engine": ">=1.0.0",
  "artifacts": [
    {
      "id": "agent-instructions",
      "source": "agent-instructions.md",
      "destination": "AGENTS.md",
      "merge": "managed-blocks",
      "lifecycle": [
        "init",
        "sync"
      ]
    },
    {
      "id": "developer-instructions",
      "source": "developers.md",
      "destination": "DEVELOPERS.md",
      "merge": "managed-blocks",
      "lifecycle": [
        "init",
        "sync"
      ]
    }
  ]
}
