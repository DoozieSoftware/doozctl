{
  "name": "@dooziesoft/doozctl",
  "version": "1.0.0-rc.1",
  "description": "A repository standards engine: turns repository knowledge into persistent, deterministic artifacts every AI assistant can share.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "cli",
    "repository",
    "standards",
    "memory",
    "codex",
    "claude"
  ],
  "homepage": "https://ctl.dooziesoft.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/DoozieSoftware/doozctl.git"
  },
  "bugs": {
    "url": "https://github.com/DoozieSoftware/doozctl/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "doozctl": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2",
    "eslint": "^9.39.5",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.1.2"
  }
}
