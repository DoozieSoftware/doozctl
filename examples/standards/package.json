{
  "format": 2,
  "name": "@dooziesoft/standards",
  "version": "1.0.0",
  "engine": ">=0.3.0",
  "artifacts": [
    {
      "id": "agents",
      "source": "artifacts/AGENTS.md",
      "destination": "AGENTS.md",
      "merge": "managed-blocks",
      "lifecycle": [
        "init",
        "sync"
      ]
    },
    {
      "id": "memory",
      "source": "artifacts/MEMORY.md",
      "destination": "MEMORY.md",
      "merge": "managed-blocks",
      "lifecycle": [
        "init",
        "sync"
      ]
    },
    {
      "id": "current-context",
      "source": "artifacts/current-context.md",
      "destination": ".ai/current-context.md",
      "merge": "overwrite",
      "lifecycle": [
        "summarize"
      ]
    },
    {
      "id": "session",
      "source": "artifacts/session.md",
      "destination": ".ai/sessions/{{session.id}}.md",
      "merge": "append",
      "lifecycle": [
        "summarize"
      ]
    }
  ]
}
