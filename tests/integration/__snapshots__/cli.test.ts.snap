// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`doozctl CLI (integration) > renders a deterministic help snapshot 1`] = `
"Usage: doozctl [options] [command]

Install and maintain AI repository standards.

Options:
  -V, --version        output the version number
  -h, --help           display help for command

Commands:
  analyze [args...]    Re-analyze the repository and update the repository
                       memory (.ai/repository-analysis.json).
  doctor [args...]     Validate the repository and report problems. Read-only.
  init [args...]       Initialize a repository with AI repository standards.
  status [args...]     Display repository status. Read-only.
  summarize [args...]  Append an immutable session summary and update the
                       current context.
  sync [args...]       Re-render managed artifacts, preserving developer
                       content.
  help [command]       display help for command
"
`;

exports[`doozctl CLI (integration) > renders a deterministic version snapshot 1`] = `
"0.3.0-alpha.1
"
`;
